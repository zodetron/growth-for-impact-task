# Postgres connection (local: postgres://localhost:5432/talent_lens ; prod: Neon URL with sslmode=require)
DATABASE_URL=postgres://localhost:5432/talent_lens

# Any OpenAI-compatible chat endpoint.
# Local Ollama:
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.1:8b
LLM_API_KEY=ollama
# Groq (production):
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
# LLM_API_KEY=gsk_...

# Set to "off" to run rules-only
LLM_ENABLED=on
